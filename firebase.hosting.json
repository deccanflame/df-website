{
  "functions": [{ "source": "functions", "codebase": "ordering", "runtime": "nodejs22", "ignore": ["node_modules", ".git", "*.log", ".secret.local", ".env.example"] }],
  "hosting": {
    "public": "out",
    "ignore": ["firebase.hosting.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "trailingSlash": true,
    "rewrites": [{ "source": "/api/square/**", "function": { "functionId": "squareOrdering", "region": "us-central1" } }],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }]
      },
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Content-Security-Policy", "value": "object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
        ]
      }
    ]
  },
  "firestore": { "rules": "firestore.rules" }
}
