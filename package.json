{
  "name": "deccan-flame",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit --incremental false",
    "build:static": "STATIC_EXPORT=true next build --webpack",
    "test:unit": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore,auth --project demo-deccan-flame --config firebase.test.json \"node --test --test-concurrency=1 tests/firestore-rules.test.mjs tests/firebase-auth.test.mjs\"",
    "test:static": "npm run build:static && node --test tests/static-export.test.mjs",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run test:static && npm run test:rules"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "firebase": "^12.18.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@cloudflare/workers-types": "5.20260907.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "firebase-tools": "^15.29.0",
    "jsdom": "^29.1.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "4.129.0"
  },
  "type": "module"
}
