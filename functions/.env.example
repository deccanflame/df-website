# Non-secret Firebase Functions configuration. Copy to functions/.env.<project-id>.
# Store SQUARE_ACCESS_TOKEN using Firebase Secret Manager, never here.
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
SQUARE_ORDERING_ENABLED=false
SQUARE_PICKUP_MINUTES=20
ORDERING_APP_ID=
# Optional comma-separated Square category IDs to limit the website's menu.
SQUARE_MENU_CATEGORY_IDS=
ORDERING_ALLOWED_ORIGINS=https://deccanflame.com,https://www.deccanflame.com
# Enable only after deploying and testing the signed Square webhook below.
COMMUNITY_PROGRESS_ENABLED=false
# Exact HTTPS notification URL registered in Square (including any trailing slash).
SQUARE_WEBHOOK_NOTIFICATION_URL=
# Store SQUARE_WEBHOOK_SIGNATURE_KEY in Firebase Secret Manager, never here.
